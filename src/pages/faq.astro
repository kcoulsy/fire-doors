---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQSchema from "../components/FAQSchema.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const faqData = [
  {
    category: "General Fire Door Services",
    questions: [
      {
        question: "What fire door services do you provide?",
        answer:
          "I provide fire door installation, repairs, maintenance and remedial work — including remedial work to existing doors against third-party fire risk assessment findings. My services cover both domestic and commercial properties across Yorkshire.",
      },
      {
        question: "How long have you been providing fire door services?",
        answer:
          "I've been on the tools since 1988. I passed the FireQual Fire Door Inspection, Installation and Maintenance qualifications in December 2024 and now specialise in fire door work.",
      },
      {
        question: "Do you work on both domestic and commercial properties?",
        answer:
          "Yes, I work on both domestic and commercial properties. From residential fire door installations to commercial fire safety compliance, I provide the same high-quality service for all types of properties.",
      },
      {
        question: "What areas do you cover?",
        answer:
          "I cover York, Leeds, Harrogate, Ripon, Wetherby, Selby and the surrounding Yorkshire towns and villages. If you're not sure whether I cover your area, just ask. Coverage and pricing are separate things: where a property sits outside my normal local operating area, travel and mobilisation is quoted as a separate line and confirmed before the work is booked.",
      },
    ],
  },
  {
    category: "Fire Door Installation",
    questions: [
      {
        question: "What affects the cost of a fire door installation?",
        answer:
          "Fire door installation costs vary depending on the type of door, frame requirements, hardware needed, and project complexity. I provide detailed quotes after assessing your specific requirements. Contact me for a consultation and quote.",
      },
      {
        question: "How long does fire door installation take?",
        answer:
          "Installation time depends on the number of doors and complexity. A single fire door typically takes 2-4 hours, while larger projects may take 1-2 days. I'll provide a detailed timeline during the quote process.",
      },
      {
        question: "Do you provide fire door frames as well?",
        answer:
          "Yes, I provide complete fire door solutions including frames, hardware, and all necessary components to ensure full compliance with fire safety regulations.",
      },
      {
        question: "Can you install fire doors in existing buildings?",
        answer:
          "Yes, I specialise in retrofitting fire doors in existing buildings. I assess the current structure and recommend the best approach for compliance and safety.",
      },
    ],
  },
  {
    category: "Fire Door Maintenance",
    questions: [
      {
        question: "How often should fire doors be maintained?",
        answer:
          "Fire doors should be maintained at least every 6 months according to fire safety regulations. Regular maintenance ensures compliance and optimal performance in case of a fire emergency.",
      },
      {
        question: "What does fire door maintenance include?",
        answer:
          "My maintenance service includes checking door operation, inspecting seals and hardware, testing self-closing devices, verifying signage, and ensuring all components meet current fire safety standards.",
      },
      {
        question: "Do you provide emergency repair services?",
        answer:
          "Yes, I provide emergency callout services for urgent fire door repairs. Contact me immediately if you have a fire door that's not functioning properly.",
      },
      {
        question: "What affects the cost of fire door maintenance?",
        answer:
          "Maintenance costs depend on the number of doors and their condition. I offer competitive rates and can provide maintenance contracts for regular servicing. Contact me for a quote.",
      },
    ],
  },
  {
    category: "Fire Door Remedial Works",
    questions: [
      {
        question: "How often should fire doors be checked?",
        answer:
          "Fire doors should be checked at least every 6 months, though some high-traffic areas may require more frequent checks. That check is normally part of your building's fire risk assessment (FRA) — I carry out any remedial work, repairs or replacement it identifies.",
      },
      {
        question: "What qualifications do you have?",
        answer:
          "I'm a City & Guilds qualified joiner with 35+ years in the trade, and I hold the FireQual Fire Door Inspection, Installation and Maintenance qualifications, gained in December 2024, plus a CSCS Gold Card. I'm also MICWCI — a Member of the Institute of Clerks of Works and Construction Inspectorate. That training and background inform the installation, repair and remedial work I carry out every day.",
      },
      {
        question: "Do you provide certificates or reports?",
        answer:
          "Yes — for completed installation, repair or remedial work I provide a written record of what was done, with photos, plus the manufacturer's certification for any components fitted (for example Certifire or BM Trada marks for FD30/FD60 doorsets). This documents the work carried out; it is not an independent fire-door inspection report or compliance certificate for the building.",
      },
      {
        question: "What happens if my fire risk assessment flags a door?",
        answer:
          "Bring me the FRA findings and I'll attend, examine the door(s) flagged, and quote the remedial work needed to address the specific issues raised. Once you approve the quote, I carry out the work and give you a written record of what was done.",
      },
      {
        question: "How much does a domestic apartment entrance fire door site visit cost?",
        answer:
          "Standard domestic fire-door site visits start from £60 + VAT (£72 including VAT) for one door. This is a site visit for pricing purposes — not an independent inspection or compliance assessment. It covers attendance, examining the door and frame, the relevant measurements and observations, an assessment of whether repair or replacement looks appropriate, and the information needed to prepare a written quotation. Additional doors are not automatically charged at £60 each; they are priced according to quantity, location and scope. Where the property is outside my normal local operating area, travel and mobilisation is added as a separate quoted line. Parking, access charges and other site-specific expenses may also apply. Every additional charge is confirmed in your quotation before the visit is booked. For remedial work to an existing door, I'll need sight of your FRA findings first — FRAs often flag an issue without giving the detail needed to quote accurately, so seeing the door in person means you get an accurate quote first time, not guesswork. Most fire doors fail on small, correctable issues — the visit identifies these so repairs can be priced efficiently without unnecessary replacement.",
      },
      {
        question: "What if I don't have an FRA report but think a door needs attention?",
        answer:
          "For remedial work to an existing fire door, I need sight of your fire risk assessment findings (or equivalent evidence of what's been flagged) before I attend — I don't offer a stand-alone independent inspection or compliance assessment. If you don't have an FRA, your first step is to get one from a suitably qualified fire risk assessor; I'm happy to quote and carry out the remedial work it identifies once you have it. If what you actually need is a new door fitting or a routine maintenance visit rather than remedial work against an FRA finding, get in touch directly — that's a straightforward installation or maintenance enquiry and doesn't need an FRA first.",
      },
    ],
  },
  {
    category: "Pricing and Quotes",
    questions: [
      {
        question: "Do you provide quotes?",
        answer:
          "Yes, I provide detailed quotes for all my services. I'll assess your requirements and provide a comprehensive quote including all necessary work and materials, plus manufacturer certification for any components fitted.",
      },
      {
        question: "Why is there a charge for the site visit?",
        answer:
          "Standard domestic fire-door site visits start from £60 + VAT (£72 including VAT) because it's a proper technical visit, not just a sales call. It involves certified measurement tools, checking the door and frame against the relevant standards (BS 8214 and BS EN 1634-1), and the professional judgement needed to quote accurately. It isn't an independent inspection or compliance assessment — it's what it costs me to attend, examine the work needed and put together an accurate written quotation. Where expressly stated in the remedial quotation, the £60 site-visit fee may be credited against subsequent remedial work. Travel, parking and other site-specific charges are not credited. For commercial properties and other services, pricing is structured differently. Contact me to discuss your requirements and receive a tailored quote.",
      },
      {
        question: "How much does commercial fire door remedial work cost?",
        answer:
          "Commercial remedial work is quoted individually — there is no standard per-door rate, because the work varies too much for one to be meaningful. What I price against: the number and type of doors, their condition and the defects identified in your fire risk assessment, how much of the building is in scope, access arrangements and working hours, travel and mobilisation, and any minimum attendance that applies. I attend, examine the doors flagged, and provide a written quotation with photographs — not an independent compliance report. Travel and mobilisation outside my normal local operating area, parking, access charges and other site-specific costs are quoted separately where they apply, and confirmed before the work is booked. Send me your FRA findings and property details — number of doors, building type and location — and I'll put a written quote together.",
      },
      {
        question: "How much does fire door installation cost?",
        answer:
          "Fire door installation costs vary depending on the type of door, frame requirements, hardware needed, and project complexity. Factors include whether it's a new installation or retrofit, door specifications, accessibility, and compliance requirements. Commercial installations are typically priced differently from domestic installations due to scale and complexity. I provide detailed quotes after assessing your specific requirements. Contact me for a consultation and quote.",
      },
      {
        question: "How much does fire door maintenance cost?",
        answer:
          "Maintenance costs depend on the number of doors, their condition, and whether the property is domestic or commercial. I offer competitive rates and can provide maintenance contracts for regular servicing, which are often more cost-effective for multiple doors or commercial properties. Commercial maintenance contracts are typically structured differently to accommodate larger properties and more frequent inspection schedules. Contact me for a quote tailored to your specific needs.",
      },
      {
        question: "Do you offer maintenance contracts?",
        answer:
          "Yes, I offer maintenance contracts for regular fire door servicing. This ensures your fire doors remain compliant and in optimal condition throughout the year. Maintenance contracts are available for both domestic and commercial properties, with pricing structured according to the number of doors, inspection frequency, and specific requirements. Commercial contracts often include volume discounts and priority service. Contact me to discuss a maintenance contract tailored to your needs.",
      },
      {
        question: "How much do emergency callouts cost?",
        answer:
          "Emergency callout costs vary depending on the nature of the emergency, time of day, location, and whether it's a domestic or commercial property. Commercial emergency callouts are typically priced differently due to the complexity and scale of commercial fire door systems. I aim to respond to emergency callouts within 24 hours, and often much sooner. Contact me immediately for urgent fire door issues and I'll provide transparent pricing based on your specific emergency situation.",
      },
      {
        question: "Is there a minimum charge for remedial or repair work?",
        answer:
          "Remedial works may be subject to a minimum half-day or full-day attendance, depending on the location, scope and resources required. Any minimum attendance and associated travel or site-specific charges will be clearly stated in the quotation before work is booked. This is separate from the domestic site-visit fee, which starts from £60 + VAT (£72 including VAT) for one door.",
      },
      {
        question: "What payment methods do you accept?",
        answer:
          "I accept bank transfers and cash. Payment terms are discussed during the quote process and are typically due upon completion of work. For commercial clients, I can arrange invoicing and payment terms that suit your business needs. All quotes include a full breakdown of materials, labour, and VAT for complete transparency. Contact me to discuss payment options.",
      },
      {
        question: "Do you charge VAT?",
        answer:
          "Yes, all my services are subject to VAT where applicable. Standard domestic fire-door site visits start from £60 plus VAT (£72 including VAT) for one door, excluding any travel, parking or other site-specific charges, which are confirmed in your quotation before attendance. For commercial clients and other services, VAT will be clearly indicated on all quotes. All final quotes include a full breakdown of materials, labour, and VAT for complete transparency.",
      },
      {
        question: "What guarantees do you offer?",
        answer:
          "I carry out every installation and repair myself — FireQual qualified, and working to BS 8214 and BM Trada / Certifire standards where applicable. Every completed door set is issued with a record sheet and photographic evidence of the work carried out, plus manufacturer certification for components fitted. I stand behind my work, with 35+ years in joinery and small-build behind it.",
      },
    ],
  },
  {
    category: "Emergency Services",
    questions: [
      {
        question: "Do you provide emergency callout services?",
        answer:
          "Yes, I provide emergency callout services for urgent fire door repairs and safety issues. Contact me immediately if you have a fire door that's not functioning properly.",
      },
      {
        question: "How quickly can you respond to emergencies?",
        answer:
          "I aim to respond to emergency callouts within 24 hours, and often much sooner depending on the nature of the emergency and your location.",
      },
      {
        question: "What constitutes a fire door emergency?",
        answer:
          "Fire door emergencies include doors that won't close properly, damaged seals, broken hardware, or any issue that compromises the door's ability to function in a fire emergency.",
      },
    ],
  },
];

// Flatten all questions for schema
const allFaqs = faqData.flatMap((category) => category.questions);

// SEO data
const seoData = {
  title:
    "Fire Door FAQ - Common Questions About Fire Door Services | Coulsy Fire Doors",
  description:
    "Get answers to common questions about fire door installation, maintenance, repairs and remedial work. Expert fire door services in Yorkshire from a FireQual qualified fire-door specialist.",
  keywords:
    "fire door FAQ, fire door questions, fire door installation, fire door maintenance, fire door remedial work, fire safety compliance, Yorkshire fire doors",
};
---

<Layout
  title={seoData.title}
  description={seoData.description}
  classes="mb-16"
>
  <!-- Breadcrumb -->
  <section class="bg-gray-50 pt-4">
    <div class="container mx-auto px-4">
      <Breadcrumb
        crumbs={[
          { label: "Home", href: "/" },
          { label: "FAQ", current: true },
        ]}
      />
    </div>
  </section>

  <!-- FAQ Schema -->
  <FAQSchema
    faqs={allFaqs}
    pageTitle="Fire Door FAQ"
    pageDescription="Common questions about fire door services, installation, maintenance, and compliance"
  />

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-brand to-brand-dark text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        Frequently Asked Questions
      </h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto mb-8">
        Get answers to common questions about fire door services, installation,
        maintenance, and compliance. Can't find what you're looking for? Get in
        touch directly.
      </p>
    </div>
  </section>

  <!-- FAQ Categories -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <!-- Category Navigation -->
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-center text-brand-900 mb-8">
            Browse by Category
          </h2>
          <div class="flex flex-wrap justify-center gap-4">
            {
              faqData.map((category, index) => (
                <button
                  class="category-btn px-6 py-3 bg-gray-100 text-gray-700 rounded-lg hover:bg-brand hover:text-white transition-colors duration-200 font-medium"
                  data-category={index}
                >
                  {category.category}
                </button>
              ))
            }
          </div>
        </div>

        <!-- FAQ Content -->
        <div class="space-y-8">
          {
            faqData.map((category, categoryIndex) => (
              <div class="faq-category" data-category={categoryIndex}>
                <h3 class="text-2xl font-bold text-brand-900 mb-6 border-b border-gray-200 pb-4">
                  {category.category}
                </h3>
                {category.category === "Pricing and Quotes" && (
                  <div class="mb-8 p-6 bg-gray-50 rounded-lg border border-gray-200">
                    <h4 class="text-xl font-semibold text-brand-900 mb-3">
                      Fire Door Pricing & FAQ
                    </h4>
                    <p class="text-gray-700 mb-3">
                      Fire safety pricing shouldn't be confusing. Travel, mobilisation, parking, access and other site-specific charges are quoted separately where they apply.
                    </p>
                    <p class="text-gray-700 mb-3">
                      Below you'll find clear, transparent pricing information for my installation, repair, maintenance and remedial work — all carried out by me, a City & Guilds qualified joiner and FireQual qualified fire-door specialist, with 35+ years in the trade.
                    </p>
                    <p class="text-gray-700">
                      Whether you're a homeowner, landlord or commercial property manager, the quoted scope, any applicable travel or site-specific charges, and any minimum attendance are set out before the work is booked. If previously concealed conditions or a requested change to the scope affect the work, I'll explain the position before carrying out additional chargeable work.
                    </p>
                  </div>
                )}
                <div class="space-y-4">
                  {category.questions.map((item, questionIndex) => (
                    <div class="faq-item bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                      <button
                        class="faq-question w-full px-6 py-4 text-left bg-gray-50 hover:bg-gray-100 transition-colors duration-200 flex justify-between items-center"
                        data-category={categoryIndex}
                        data-question={questionIndex}
                      >
                        <span class="font-medium text-gray-800">
                          {item.question}
                        </span>
                        <svg
                          class="faq-icon w-5 h-5 text-gray-500 transform transition-transform duration-200"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"
                          />
                        </svg>
                      </button>
                      <div class="faq-answer hidden px-6 py-4 bg-white border-t border-gray-200">
                        <p class="text-gray-600 leading-relaxed">
                          {item.answer}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Contact Section -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-brand-900 mb-4">
          Ready to Request a Quote?
        </h2>
        <p class="text-xl text-gray-600 mb-4">
          Can't find the answer you're looking for? Get in touch directly and
          I'll be happy to help.
        </p>
        <p class="text-lg text-gray-700 mb-8 font-medium">
          Call <a href="tel:07544030486" class="text-brand hover:text-brand-dark">07544 030486</a> or email <a href="mailto:robert@coulsy.co.uk" class="text-brand hover:text-brand-dark">robert@coulsy.co.uk</a>
        </p>
        <p class="text-gray-600 italic">
          Serving Yorkshire and surrounding areas — trusted by property managers, landlords, and building owners for reliable, compliant fire door services.
        </p>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-brand-900 mb-4">
              Get in Touch
            </h3>
            <div class="space-y-3 text-left">
              <div class="flex items-center">
                <svg
                  class="w-5 h-5 text-brand mr-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
                <span class="text-gray-600">07544 030486</span>
              </div>
              <div class="flex items-center">
                <svg
                  class="w-5 h-5 text-brand mr-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
                <span class="text-gray-600">robert@coulsy.co.uk</span>
              </div>
              <div class="flex items-center">
                <svg
                  class="w-5 h-5 text-brand mr-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="text-gray-600">Yorkshire & Surrounding Areas</span>
              </div>
            </div>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-brand-900 mb-4">
              Quick Response
            </h3>
            <ul class="text-left space-y-2 text-gray-600">
              <li>• Professional consultations and quotes</li>
              <li>• Emergency callout service</li>
              <li>• Flexible appointment times</li>
              <li>• 35+ years in the trade</li>
              <li>• FireQual qualified fire-door specialist</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section id="contact" class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-brand-900 mb-12">
          Get Your Quote
        </h2>
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>

<script>
  // @ts-nocheck
  // FAQ functionality
  document.addEventListener("DOMContentLoaded", function () {
    const categoryBtns = document.querySelectorAll(".category-btn");
    const faqCategories = document.querySelectorAll(".faq-category");
    const faqQuestions = document.querySelectorAll(".faq-question");

    // Category filtering
    categoryBtns.forEach((btn) => {
      btn.addEventListener("click", function () {
        const categoryIndex = this.getAttribute("data-category");

        // Update active button
        categoryBtns.forEach((b) =>
          b.classList.remove("bg-brand", "text-white")
        );
        categoryBtns.forEach((b) =>
          b.classList.add("bg-gray-100", "text-gray-700")
        );
        this.classList.remove("bg-gray-100", "text-gray-700");
        this.classList.add("bg-brand", "text-white");

        // Show/hide categories
        faqCategories.forEach((category, index) => {
          if (categoryIndex === "all" || index === parseInt(categoryIndex)) {
            category.style.display = "block";
          } else {
            category.style.display = "none";
          }
        });
      });
    });

    // FAQ accordion
    faqQuestions.forEach((question) => {
      question.addEventListener("click", function () {
        const answer = this.nextElementSibling;
        const icon = this.querySelector(".faq-icon");

        // Toggle answer visibility
        answer.classList.toggle("hidden");

        // Rotate icon
        if (answer.classList.contains("hidden")) {
          icon.style.transform = "rotate(0deg)";
        } else {
          icon.style.transform = "rotate(180deg)";
        }
      });
    });

    // Show all categories by default
    categoryBtns[0].click();
  });
</script>
