---
interface Props {
  title?: string;
  subtitle?: string;
  showHeader?: boolean;
  showPhone?: boolean;
  className?: string;
  location?: string;
  serviceType?: string;
  uniqueId?: string;
}

const {
  title = "Get Your Fire Door Quote",
  subtitle = "Tell me about your fire doors and I'll get back to you with straight advice and a quote.",
  // When false, the form's own heading/subtitle are suppressed so a page that
  // already has its own section heading does not render a second one. Defaults
  // true, so every existing caller is unchanged.
  showHeader = true,
  showPhone = true,
  className = "",
  location,
  serviceType,
  uniqueId = "",
} = Astro.props;

// Generate unique IDs for form elements
const formId = uniqueId
  ? `modern-contact-form-${uniqueId}`
  : "modern-contact-form";
const submitButtonId = uniqueId ? `submit-button-${uniqueId}` : "submit-button";
const sendIconId = uniqueId ? `send-icon-${uniqueId}` : "send-icon";
const buttonTextId = uniqueId ? `button-text-${uniqueId}` : "button-text";
const loadingSpinnerId = uniqueId
  ? `loading-spinner-${uniqueId}`
  : "loading-spinner";
const successMessageId = uniqueId
  ? `success-message-${uniqueId}`
  : "success-message";
const errorMessageId = uniqueId ? `error-message-${uniqueId}` : "error-message";

// Fixed and IDENTICAL on every page — never derived from Astro.url or any
// other per-page value. This form's `name="contact"` is shared across all
// ~175 pages that embed it, and Netlify's deploy-time scanner registers only
// ONE action for a shared form name sitewide (whichever instance it parses
// last) — see the 5 Nov 2026 incident this is fixing. A per-page action
// therefore sent some genuine submissions to a redirect target belonging to
// a different page, which 404'd. /contact always exists, so this fallback
// action is only ever used if JavaScript fails to load (see script below,
// which submits via fetch() for everyone else and never hits this at all).
const successAction = "/contact?success=true#form-success-target";
---

<div
  class={`bg-white rounded-xl shadow-lg border border-gray-200 p-6 ${className}`}
>
  {showHeader && (
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">{title}</h2>
      <p class="text-gray-600">{subtitle}</p>
    </div>
  )}

  <!-- Anchor the no-JS fallback's success redirect targets here, immediately
       before the banners it needs to reveal via the :target ~ selector below
       (general sibling selectors only match elements that come AFTER this
       one in the DOM, so this must stay directly above the two banners). -->
  <span id="form-success-target" aria-hidden="true" tabindex="-1"></span>

  <!-- Success Message — shown above the form (not appended after it) so it's
       prominent without requiring a scroll on a short viewport; scrollIntoView
       in the script below handles the case where it still isn't in view. -->
  <div
    id={successMessageId}
    role="status"
    aria-live="polite"
    aria-atomic="true"
    tabindex="-1"
    class="hidden mb-4 p-4 bg-green-50 border border-green-200 rounded-lg"
  >
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center">
        <svg
          class="w-5 h-5 text-green-500 mr-2 flex-shrink-0"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span class="text-green-800 font-medium"
          >Message sent successfully! We'll get back to you soon.</span
        >
      </div>
      <button
        type="button"
        data-dismiss-banner
        aria-label="Dismiss confirmation"
        class="flex-shrink-0 text-green-600 hover:text-green-800 focus:outline-none focus:ring-2 focus:ring-green-500 rounded p-1"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Error Message — same prominent placement and dismiss pattern. role="alert"
       is itself an implicit assertive live region; aria-live is kept explicit
       too for broader screen-reader support. -->
  <div
    id={errorMessageId}
    role="alert"
    aria-live="assertive"
    aria-atomic="true"
    tabindex="-1"
    class="hidden mb-4 p-4 bg-red-50 border border-red-200 rounded-lg"
  >
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center">
        <svg
          class="w-5 h-5 text-red-500 mr-2 flex-shrink-0"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
            clip-rule="evenodd"></path>
        </svg>
        <span class="text-red-800 font-medium"
          >Something went wrong. Please try again or call us directly.</span
        >
      </div>
      <button
        type="button"
        data-dismiss-banner
        aria-label="Dismiss error message"
        class="flex-shrink-0 text-red-600 hover:text-red-800 focus:outline-none focus:ring-2 focus:ring-red-500 rounded p-1"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <form
    id={formId}
    name="contact"
    method="post"
    action={successAction}
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="space-y-4"
  >
    <!-- Hidden form name for Netlify -->
    <input type="hidden" name="form-name" value="contact" />

    <!-- Netlify honeypot. Kept in the DOM because Netlify matches it by name,
         but taken out of the tab order and the accessibility tree so it is
         never offered to a real visitor. autocomplete="off" matters: a password
         manager filling this would make Netlify silently discard a genuine
         enquiry as spam. The label follows Netlify's documented pattern and is
         the fallback if the CSS ever fails to load. -->
    <div class="hidden" aria-hidden="true">
      <label for="bot-field">Do not fill this in if you are human</label>
      <input id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Name Field -->
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
        Full Name <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        autocomplete="name"
        required
        placeholder="Enter your full name"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1e3a8a] focus:border-[#1e3a8a] transition-colors"
      />
    </div>

    <!-- Email Field -->
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
        Email Address <span class="text-red-500">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        autocomplete="email"
        required
        placeholder="Enter your email address"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1e3a8a] focus:border-[#1e3a8a] transition-colors"
      />
    </div>

    <!-- Phone Field -->
    {
      showPhone && (
        <div>
          <label
            for="phone"
            class="block text-sm font-medium text-gray-700 mb-1"
          >
            Phone Number <span class="text-red-500">*</span>
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            autocomplete="tel"
            required
            placeholder="Enter your phone number"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1e3a8a] focus:border-[#1e3a8a] transition-colors"
          />
        </div>
      )
    }

    <!-- Message Field -->
    <div>
      <label for="message" class="block text-sm font-medium text-gray-700 mb-1">
        Project Details <span class="text-red-500">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        placeholder="Tell me about your fire doors — building type, number of doors, and whether this is a new installation, repair/maintenance, or remedial work against a fire risk assessment..."
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1e3a8a] focus:border-[#1e3a8a] transition-colors resize-vertical"
      ></textarea>
    </div>

    <!-- Submit Button -->
    <button
      type="submit"
      id={submitButtonId}
      class="w-full bg-[#1e2a38] hover:bg-[#1e3a8a] text-white font-semibold py-3 px-6 rounded-lg transition-all duration-300 ease-out focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed hover:scale-[1.02] hover:shadow-lg active:scale-[0.98] transform"
    >
      <div class="flex items-center justify-center">
        <svg
          id={sendIconId}
          class="w-5 h-5 mr-2 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
        </svg>
        <span id={buttonTextId}>Send Message</span>
        <div
          id={loadingSpinnerId}
          class="hidden w-5 h-5 mr-2 border-2 border-white border-t-transparent rounded-full animate-spin"
        >
        </div>
      </div>
    </button>
  </form>

  <!-- Contact Info -->
  <div class="mt-6 pt-6 border-t border-gray-200">
    <div class="text-center">
      <p class="text-sm text-gray-600 mb-2">Prefer to call?</p>
      <a
        href="tel:07544 030486"
        class="text-[#1e2a38] hover:text-[#1e3a8a] font-semibold text-lg transition-colors duration-200"
      >
        Robert: 07544 030486
      </a>
    </div>
  </div>
</div>

<script
  define:vars={{
    location,
    serviceType,
    formId,
    submitButtonId,
    sendIconId,
    buttonTextId,
    loadingSpinnerId,
    successMessageId,
    errorMessageId,
  }}
>
  // Enhanced contact form with micro-interactions
  document.addEventListener("DOMContentLoaded", function () {
    const successMessage = document.getElementById(successMessageId);
    const errorMessage = document.getElementById(errorMessageId);
    const submitButton = document.getElementById(submitButtonId);
    const sendIcon = document.getElementById(sendIconId);
    const buttonText = document.getElementById(buttonTextId);
    const loadingSpinner = document.getElementById(loadingSpinnerId);
    const form = document.getElementById(formId);
    const messageField = document.getElementById("message");

    // Deliberately no auto-hide timer. The previous version scheduled one
    // unconditional setTimeout(..., 8000) per call with nothing to cancel a
    // still-pending one from an earlier call — a second banner (e.g. shown
    // after a retry) could be hidden almost immediately by a stale timer
    // left over from the first. Banners now stay until the visitor dismisses
    // them (the button below) or leaves the page.
    function showBanner(el) {
      if (!el) return;
      hideBanner(successMessage === el ? errorMessage : successMessage);
      el.classList.remove("hidden");
      el.style.animation = "slideInUp 0.5s ease-out";
      // Bring it into view and move focus to it — required regardless of
      // where on a long page the form happens to sit, not just on short
      // viewports.
      el.scrollIntoView({ behavior: "smooth", block: "center" });
      el.focus();
    }

    function hideBanner(el) {
      if (!el) return;
      el.classList.add("hidden");
      el.style.animation = "";
    }

    function resetSubmitButton() {
      if (submitButton && sendIcon && buttonText && loadingSpinner) {
        submitButton.disabled = false;
        sendIcon.classList.remove("hidden");
        buttonText.textContent = "Send Message";
        loadingSpinner.classList.add("hidden");
      }
    }

    // Dismiss buttons inside each banner (added to the markup above).
    [successMessage, errorMessage].forEach(function (banner) {
      if (!banner) return;
      const dismissBtn = banner.querySelector("[data-dismiss-banner]");
      if (dismissBtn) {
        dismissBtn.addEventListener("click", function () {
          hideBanner(banner);
        });
      }
    });

    // Button micro-interactions
    if (submitButton) {
      // Hover effect - icon moves slightly
      submitButton.addEventListener("mouseenter", function () {
        if (sendIcon) {
          sendIcon.style.transform = "translateX(2px) rotate(12deg)";
        }
      });

      submitButton.addEventListener("mouseleave", function () {
        if (sendIcon) {
          sendIcon.style.transform = "translateX(0) rotate(0deg)";
        }
      });

      // Click effect - button scales down
      submitButton.addEventListener("mousedown", function () {
        this.style.transform = "scale(0.98)";
      });

      submitButton.addEventListener("mouseup", function () {
        this.style.transform = "scale(1.02)";
      });
    }

    // Submit via fetch rather than relying on the browser's native POST
    // navigation. This is deliberate, not cosmetic: this form's name="contact"
    // is shared across ~175 pages, and Netlify's deploy-time scanner keeps
    // only ONE action for a shared form name sitewide — a genuine submission
    // from any page other than whichever one Netlify happened to register
    // could be redirected to the wrong page's address and 404 (confirmed live,
    // 5 Nov 2026). Submitting via fetch sidesteps that entirely: Netlify Forms
    // still receives and records the POST exactly as it would a native one
    // (same fields, same form-name, same honeypot), but this page never
    // navigates anywhere, so there is no action/redirect to get wrong.
    if (form) {
      form.addEventListener("submit", function (e) {
        e.preventDefault();

        // Guard against a duplicate in-flight submission — not just via the
        // disabled submit button (which a fast double-click or an
        // Enter-triggered implicit submission from another field can race),
        // but as the authoritative check. Cleared once the fetch settles,
        // either way, in the finally-equivalent below.
        if (form.dataset.submitting === "true") {
          return;
        }
        form.dataset.submitting = "true";

        if (messageField && location && serviceType && !messageField.dataset.locationAppended) {
          const currentMessage = messageField.value || "";
          const locationInfo = `\n\n---\nInquiry from: ${location} (${serviceType})`;
          messageField.value = currentMessage + locationInfo;
          messageField.dataset.locationAppended = "true";
        }

        if (submitButton && sendIcon && buttonText && loadingSpinner) {
          submitButton.disabled = true;
          sendIcon.classList.add("hidden");
          buttonText.textContent = "Sending...";
          loadingSpinner.classList.remove("hidden");
        }

        const body = new URLSearchParams(new FormData(form));
        fetch(window.location.pathname, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: body.toString(),
        })
          .then((response) => {
            form.dataset.submitting = "false";
            resetSubmitButton();
            if (response.ok) {
              showBanner(successMessage);
              form.reset();
              // form.reset() clears the location-info flag along with the
              // field's value, so a second genuine enquiry on the same page
              // load still gets the location info appended once.
              if (messageField) delete messageField.dataset.locationAppended;
            } else {
              showBanner(errorMessage);
            }
          })
          .catch(() => {
            form.dataset.submitting = "false";
            resetSubmitButton();
            showBanner(errorMessage);
          });
      });
    }
  });
</script>

<style>
  /* Button micro-interaction animations */
  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideOutDown {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  /* Enhanced button hover effects */
  button[type="submit"]:hover {
    box-shadow: 0 10px 25px rgba(30, 42, 56, 0.3);
  }

  button[type="submit"]:active {
    transform: scale(0.98);
  }

  /* Loading spinner animation */
  .animate-spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* No-JS fallback only. With JavaScript available, the submit handler above
     calls preventDefault() and this native action/redirect never fires at
     all — every real submission goes through fetch() instead. This rule only
     matters if JavaScript fails to load: the browser then falls back to a
     native POST to the fixed action above, landing on /contact?success=true,
     and this shows the banner based on the URL fragment alone. That's a
     weaker guarantee than the fetch path (nothing can tell a genuine no-JS
     submission apart from someone following/guessing the exact link without
     JS to check it), and it always lands on /contact specifically rather
     than the page the visitor was actually on — both accepted trade-offs for
     a visitor without JavaScript, not a concern for anyone else. */
  #form-success-target:target ~ [id^="success-message"] {
    display: block !important;
  }
</style>
